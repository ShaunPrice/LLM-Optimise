{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM-Optimise",
  "version": "0.1.0",
  "identifier": "io.shaunprice.llm-optimise",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "launcher", "title": "LLM-Optimise", "width": 860, "height": 650, "minWidth": 680, "minHeight": 550}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Specialised intelligence on constrained hardware",
    "longDescription": "A local desktop laboratory for measured LLM optimisation, model routing, chat and development.",
    "resources": {"resources/service.py": "service.py"},
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion": "12.0"}
  }
}
